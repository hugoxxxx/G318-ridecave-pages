{
  "name": "g318-ridecave",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests scripts *.json *.ts *.html *.md .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts *.json *.ts *.html *.md .github/workflows/*.yml"
  },
  "dependencies": {
    "@tmcw/togeojson": "7.1.3",
    "@turf/along": "7.4.0",
    "@turf/distance": "7.4.0",
    "@turf/nearest-point-on-line": "7.4.0",
    "@turf/simplify": "7.4.0",
    "@xmldom/xmldom": "0.9.12",
    "fit-file-parser": "6.2.3",
    "flatbush": "4.6.2",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "license": "MIT"
}
